{
  "name": "@ndrsc3/web-threshold",
  "version": "0.4.0",
  "description": "The Threshold — how anyone or anything comes in: a single-input, secret-to-tier entry gate as a Web Component (<web-threshold>), and a generated robots.txt from one config.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndrsc3/web-threshold.git"
  },
  "main": "./dist/web-threshold.js",
  "module": "./dist/web-threshold.js",
  "types": "./dist/gate/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/gate/index.d.ts",
      "import": "./dist/web-threshold.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy.js"
    },
    "./sealed": {
      "types": "./dist/gate/sealed-entry.d.ts",
      "import": "./dist/web-threshold-sealed.js"
    }
  },
  "bin": {
    "web-threshold": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/web-threshold.js",
    "./dist/web-threshold-sealed.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.sealed.config.ts && vite build -c vite.cli.config.ts && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "test": "vitest run",
    "demo:build": "node scripts/build-demo.mjs",
    "demo": "npm run demo:build && vite preview --outDir .demo --port 4173",
    "test:consumer": "node scripts/test-consumer.mjs",
    "test:browsers": "node scripts/test-browsers.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "happy-dom": "^15.11.7",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
