{
  "name": "@ndrsc3/web-threshold",
  "version": "0.3.0",
  "description": "The Threshold — a single-input, secret-to-tier entry gate as a Web Component (<web-threshold>).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndrsc3/web-threshold.git"
  },
  "main": "./dist/web-threshold.js",
  "module": "./dist/web-threshold.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/web-threshold.js"
    }
  },
  "files": ["dist"],
  "sideEffects": ["./dist/web-threshold.js"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
